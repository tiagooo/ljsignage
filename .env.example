# Copiar para .env (nunca fazer commit do .env). Ver docs/SPEC.md §10.

# --- Aplicação -------------------------------------------------------------
# Gerar com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
TZ=Europe/Lisbon
# Pasta de dados: SQLite, media, miniaturas, backups. No Docker é /data.
DATA_DIR=./data
DEVICES_FILE=config/devices.yaml
LOG_LEVEL=INFO

# --- Autenticação (Google OAuth, só contas autorizadas) --------------------
# Credenciais OAuth criadas na Google Cloud Console (tipo "Aplicação Web").
# URI de redirecionamento autorizado: https://<endereço-do-painel>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_DOMAIN=lugardajoia.com
# Administradores (separados por vírgulas). Os editores são autorizados no painel.
ADMIN_EMAILS=nome.apelido@lugardajoia.com
# Só para desenvolvimento local sem Google (exige FLASK_DEBUG=1). Nunca em produção.
AUTH_DEV_LOGIN=false
# true quando o painel é servido por HTTPS (recomendado atrás do proxy).
SESSION_COOKIE_SECURE=false
# true quando existe um proxy à frente (lê X-Forwarded-For/Proto/Host).
TRUST_PROXY=false

# --- FTP dos Raspberry Pi --------------------------------------------------
FTP_USER=
FTP_PASSWORD=
# Sobreposição por dispositivo (sigla em maiúsculas), se as credenciais variarem:
# FTP_USER__UBBO=
# FTP_PASSWORD__UBBO=
FTP_TIMEOUT_S=10

# --- Reconciliação ---------------------------------------------------------
# true = só lê as lojas e mostra o plano; nada é escrito nos Pis.
DRY_RUN=true
RECONCILE_INTERVAL_MIN=5
STAGING_LOOKAHEAD_H=48
MAX_PARALLEL=3

# --- Media -----------------------------------------------------------------
AUDIO_ENABLED=false
MAX_UPLOAD_MB=8192

# --- Docker (docker-compose.yml) -------------------------------------------
WEB_PORT=8080
DNS_PRIMARY=10.0.2.2
DNS_SECONDARY=10.0.2.20
